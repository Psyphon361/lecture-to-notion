# Used from Phase 3. Server-side only. Do not commit a real value.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (free tier, confirmed Sep 29, 2026).
GEMINI_MODEL=

# Server-side fallback when no OAuth session exists. Do not commit a real value.
NOTION_TOKEN=

# Parent page shared with this connection and with Vasu. Server-side only.
# OAuth sessions can store a chosen page instead; this value wins when set.
NOTION_PARENT_PAGE_ID=

# Notion public connection. Server-side only. Do not commit real values.
# Create one under Developer portal -> Public connections, with installation
# scope "Selected workspaces only" and capabilities read content + insert content.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Must match a redirect URI registered on the public connection exactly.
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/notion/oauth/callback

# 32-byte key for the encrypted session cookie. Generate once and keep it secret:
#   openssl rand -base64 32
NOTION_OAUTH_ENCRYPTION_KEY=
